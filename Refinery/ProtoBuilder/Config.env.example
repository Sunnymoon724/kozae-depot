# Copy this file to Config.env and edit the values.

# Absolute path to Excel proto folder
PROTO_FOLDER=D:\Data\Proto

# csharp or cpp
LANGUAGE=csharp

# Deploy destinations (Plugin headers/lib or dll, Proto .bytes)
PLUGIN_OUTPUT=D:\Data\Game\Plugin
PROTO_OUTPUT=D:\Data\Game\Resource\Proto

# 1 = keep ProtoOutput (incl. Csv). 0 = delete ProtoOutput after deploy.
KEEP_CSV=0
